# CCL2026-DIMT Pipeline Configuration
# Copy this file to .env and fill in your values.
# .env is gitignored and will not be committed.
#
# Global settings only. Solution-specific backends (render/erasure/VLM/CoT)
# are hardcoded in run_all_solutions.py and are NOT configurable via env vars.

# --- Translation API (OpenAI-compatible) ---
TRANSLATION_MODEL=GLM-5.1
TRANSLATION_API_BASE=http://127.0.0.1:8082/v1
TRANSLATION_API_KEY=
TRANSLATION_MAX_TOKENS=2048
TRANSLATION_TEMPERATURE=0.3

# --- VLM for image context analysis (Solution B) ---
VLM_API_BASE=
VLM_API_KEY=
VLM_MODEL=qwen3.7-plus

# --- Hardware ---
DEVICE=cpu
BATCH_SIZE=1

# --- Debug switches (true/false) ---
DEBUG_ENABLED=true
DEBUG_OCR=true
DEBUG_MASK=true
DEBUG_ERASED=true
DEBUG_TRANSLATION=true
DEBUG_STYLE=true
DEBUG_CLASSIFICATION=true
DEBUG_QUALITY=true
DEBUG_RENDER=true
DEBUG_ORIGINAL=true
DEBUG_CONTEXT=true
DEBUG_PRODUCT=true
