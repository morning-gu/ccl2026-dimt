# CCL2026-DIMT Pipeline Configuration
# Copy this file to .env and fill in your values.
# .env is gitignored and will not be committed.
#
# Global settings only. Solution-specific backends (render/erasure/VLM/CoT)
# are hardcoded in run_all_solutions.py and are NOT configurable via env vars.

# --- Translation API (OpenAI-compatible) ---
TRANSLATION_MODEL=GLM-5.1
TRANSLATION_API_BASE=http://127.0.0.1:8082/v1
TRANSLATION_API_KEY=
TRANSLATION_MAX_TOKENS=2048
TRANSLATION_TEMPERATURE=0.3

# --- Target languages ---
# Comma- or space-separated language codes. Supported: en es pt ja fr
# TARGET_LANGS=en es pt ja fr

# --- VLM for image context analysis (Solution B) ---
VLM_API_BASE=
VLM_API_KEY=
VLM_MODEL=qwen3.7-plus

# --- FLUX-Text renderer (Solution E) ---
# Clone: git clone https://github.com/AMAP-ML/FluxText.git
# Weights: https://huggingface.co/GD-ML/FLUX-Text
FLUXTEXT_REPO_PATH=
FLUXTEXT_MODEL_PATH=
FLUXTEXT_CONFIG_PATH=
FLUXTEXT_FONT_PATH=

# --- EasyText renderer (Solution F) ---
# Clone: git clone https://github.com/songyiren725/EasyText.git
# Weights: FLUX.1-dev from HuggingFace + EasyText LoRA weights
EASYTEXT_REPO_PATH=
EASYTEXT_FLUX_PATH=black-forest-labs/FLUX.1-dev
EASYTEXT_PRETRAIN_LORA=
EASYTEXT_FINETUNE_LORA=
EASYTEXT_FONT_PATH=

# --- Hardware ---
DEVICE=cpu
BATCH_SIZE=1

# --- Debug switches (true/false) ---
DEBUG_ENABLED=true
DEBUG_OCR=true
DEBUG_MASK=true
DEBUG_ERASED=true
DEBUG_TRANSLATION=true
DEBUG_STYLE=true
DEBUG_CLASSIFICATION=true
DEBUG_QUALITY=true
DEBUG_RENDER=true
DEBUG_ORIGINAL=true
DEBUG_CONTEXT=true
DEBUG_PRODUCT=true
