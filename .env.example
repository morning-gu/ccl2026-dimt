# CCL2026-DIMT Pipeline Configuration
# Copy this file to .env and fill in your values.
# .env is gitignored and will not be committed.
#
# Global settings only. Solution-specific backends (render/erasure/VLM/CoT)
# are hardcoded in run_all_solutions.py and are NOT configurable via env vars.

# --- Translation API (OpenAI-compatible) ---
TRANSLATION_MODEL=GLM-5.1
TRANSLATION_API_BASE=http://127.0.0.1:8082/v1
TRANSLATION_API_KEY=
TRANSLATION_MAX_TOKENS=2048
TRANSLATION_TEMPERATURE=0.3

# --- Target languages ---
# Comma- or space-separated language codes. Supported: en es pt ja fr
# TARGET_LANGS=en es pt ja fr

# --- VLM for image context analysis (Solution B) ---
VLM_API_BASE=
VLM_API_KEY=
VLM_MODEL=qwen3.7-plus

# --- FLUX-Text renderer (Solution E) ---
# Server-client architecture: start the FluxText API server (servers/fluxtext_server.py)
# in the FluxText repo environment, then point the pipeline to its URL.
# Server-side env vars (FLUXTEXT_REPO_PATH, FLUXTEXT_MODEL_PATH, etc.) are read
# by the server process, not by the pipeline.
FLUXTEXT_API_URL=http://localhost:8002/render
FLUXTEXT_API_TIMEOUT=120
# Server-side: quantization (default=8bit, best quality for A10 24GB + 32GB RAM)
#   none=full precision ~34GB RAM, nf4=4-bit ~6GB, 8bit=8-bit ~12GB, 8bit_all=8-bit+T5
# FLUXTEXT_QUANTIZE=nf4
# Server-side: CPU offload (default=model when quantize!=none)
#   none=full GPU, model=per-component, sequential=per-layer
# FLUXTEXT_OFFLOAD=model

# --- EasyText renderer (Solution F) ---
# Server-client architecture: start the EasyText API server (servers/easytext_server.py)
# in the EasyText repo environment, then point the pipeline to its URL.
# Server-side env vars (EASYTEXT_REPO_PATH, EASYTEXT_FLUX_PATH, etc.) are read
# by the server process, not by the pipeline.
EASYTEXT_API_URL=http://localhost:8001/render
EASYTEXT_API_TIMEOUT=120
# Server-side: GPU offload strategy (none=model on GPU ~34GB, model=per-component offload ~12-16GB, sequential=per-layer offload ~8-10GB)
# EASYTEXT_OFFLOAD=model
# Server-side: quantize transformer (none=no quant, nf4=4-bit ~6GB via bitsandbytes, fp8=8-bit ~12GB via optimum-quanto)
# EASYTEXT_QUANT=nf4

# --- AnyText2 renderer (Solution A/B) ---
# Server-client architecture: start the AnyText2 API server (servers/anytext2_server.py)
# in the AnyText2 repo environment, then point the pipeline to its URL.
ANYTEXT2_API_URL=http://localhost:8003/render
ANYTEXT2_API_TIMEOUT=120

# --- STRNet eraser ---
# Server-client architecture: start the STRNet API server (servers/strokenet_server.py)
STROKENET_API_URL=http://localhost:8011/erase
STROKENET_API_TIMEOUT=120

# --- PERT eraser ---
# Server-client architecture: start the PERT API server (servers/pert_server.py)
PERT_API_URL=http://localhost:8012/erase
PERT_API_TIMEOUT=120

# --- SSER (Self-supervised Text Erasing) ---
# Server-client architecture: start the SSER API server (servers/sser_server.py)
SSER_API_URL=http://localhost:8013/erase
SSER_API_TIMEOUT=120

# --- Hardware ---
DEVICE=cpu
BATCH_SIZE=1

# --- Debug switches (true/false) ---
DEBUG_ENABLED=true
DEBUG_OCR=true
DEBUG_MASK=true
DEBUG_ERASED=true
DEBUG_TRANSLATION=true
DEBUG_STYLE=true
DEBUG_CLASSIFICATION=true
DEBUG_QUALITY=true
DEBUG_RENDER=true
DEBUG_ORIGINAL=true
DEBUG_CONTEXT=true
DEBUG_PRODUCT=true
